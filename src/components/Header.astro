---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/meditaciones', label: 'Meditaciones' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="sticky top-0 z-50 border-b border-brand-200/50 bg-surface/80 backdrop-blur-md dark:border-night-700/50">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-brand-700 dark:text-brand-100">
      <img src="/logo-isotipo.png" alt="Aprende a Meditar" class="h-8 w-8" />
      <span>aprendeameditar</span>
    </a>

    <nav class="hidden gap-6 text-sm sm:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-night-700 transition hover:text-brand-600 dark:text-brand-100 dark:hover:text-brand-300">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <details class="relative sm:hidden">
        <summary class="cursor-pointer list-none rounded-full p-2 hover:bg-brand-100 dark:hover:bg-night-800">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav class="absolute right-0 mt-2 flex w-40 flex-col gap-1 rounded-xl border border-brand-200/50 bg-surface p-3 shadow-lg dark:border-night-700/50">
          {navItems.map((item) => (
            <a href={item.href} class="rounded-lg px-2 py-1.5 text-sm hover:bg-brand-50 dark:hover:bg-night-800">
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>