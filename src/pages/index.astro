---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import Player from "../components/player/Player";
import type { Track } from "../components/player/types";
import { cap, norm } from "../lib/format";

const meditaciones = (await getCollection("meditaciones")).sort((a, b) => a.id.localeCompare(b.id));

const tracks: Track[] = meditaciones.map((m) => ({
  id: m.id,
  title: m.data.title,
  category: m.data.category,
  audio: m.data.audioSrc,
  duration: m.data.duration * 60, // el schema guarda minutos; el reproductor usa segundos
}));

// Categorías únicas, en el orden en que aparecen
const categories = [...new Map(tracks.map((t) => [norm(t.category), cap(t.category)])).entries()];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<Layout title="Aprende a Meditar · Meditaciones guiadas para empezar">
  <Player client:load tracks={tracks} />

  <h1 class="mt-2 mb-1.5 text-center font-display text-2xl font-medium italic sm:text-[30px]">
    Un espacio simple para respirar, sin complicarte
  </h1>
  <p class="mx-auto mb-[26px] max-w-130 text-center text-[15px] text-muted">
    Sin cursos largos ni jerga. Elige cómo te sientes y encuentra una meditación que te ayude ahora mismo.
  </p>

  <!-- Son enlaces reales (funcionan sin JS); el script de abajo los convierte en filtros del buscador -->
  <nav class="mb-[46px] flex flex-wrap justify-center gap-2.5" aria-label="Meditaciones por categoría">
    {
      categories.map(([key, label]) => (
        <a
          href={`/meditaciones?categoria=${key}`}
          data-open-search
          data-cat={key}
          class="cursor-pointer rounded-full border border-glass-border bg-ghost px-4 py-2 text-[13px] text-ink no-underline transition-colors hover:bg-accent-soft focus-visible:outline-2 focus-visible:outline-accent"
        >
          {label}
        </a>
      ))
    }
  </nav>

  <section aria-labelledby="del-blog">
    <h2 id="del-blog" class="mb-4 text-sm font-bold tracking-[0.03em] text-muted uppercase">Del blog</h2>
    <div class="mb-10 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3.5">
      {posts.map((p) => <BlogCard href={`/blog/${p.id}`} title={p.data.title} description={p.data.description} />)}
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-open-search]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent("open-search", { detail: { cat: a.dataset.cat } }));
    });
  });
</script>
